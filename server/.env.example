MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/interview
JWT_SECRET=change_me_to_a_long_random_string
REDIS_HOST=your-instance.upstash.io
REDIS_PORT=6379
REDIS_PASSWORD=
# Optional: set false for a local non-TLS Redis (auto-detected for localhost)
# REDIS_TLS=false
CLIENT_URL=http://localhost:5173
# Code runner: self-hosted Piston (recommended) or public API + token
PISTON_URL=http://localhost:2000/api/v2/execute
# PISTON_TOKEN=
# Set false to run the worker as a separate process (npm run worker)
# RUN_WORKER=false
